#version 460

#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_GOOGLE_include_directive : enable

layout(scalar, set = 0, binding = 0) readonly buffer _histogram {
    // 16.16 fixed point
    uint data[];
} histogram;
const float HISTOGRAM_SCALE = 65536.0;
layout(set = 0, binding = 1, r32f) uniform writeonly image3D cdf;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    ivec3 size = imageSize(cdf);
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(xy, size.xy))) return;

    float total = 0.0;
    // TODO: figure out if we want to run this backwards
    for (int bin = 0; bin < size.z; ++bin) {
        uint index = (xy.x * size.y + xy.y) * size.z + bin;
        // TODO: does this need "nonuniformEXT"?
        total += float(histogram.data[index]) / HISTOGRAM_SCALE;
        imageStore(cdf, ivec3(xy, bin), vec4(total, 0.0, 0.0, 0.0));
    }
    // float v = 0.0;
    // // TODO: figure out if we want to run this backwards
    // for (int bin = 0; bin < size.z; ++bin) {
    //     uint index = (xy.x * size.y + xy.y) * size.z + bin;
    //     // TODO: does this need "nonuniformEXT"?
    //     v += histogram.data[index];
    //     imageStore(cdf, ivec3(xy, bin), vec4(v / total, 0.0, 0.0, 0.0));
    // }
}
